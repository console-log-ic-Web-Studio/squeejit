---
import CtaButton from "../components/CtaButton.astro";
import { finalCta } from "../data/product";
---

<section class="relative overflow-hidden bg-ink-900">
  <div class="texture-stripe h-1.5 w-full opacity-80"></div>

  <div
    class="absolute inset-0 bg-gradient-to-br from-brand-700/40 via-ink-900 to-ink-900"
    aria-hidden="true"
  >
  </div>
  <img
    src="/images/trail-scene.webp"
    alt=""
    width="1096"
    height="744"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-lighten"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/60 to-ink-900/80" aria-hidden="true"></div>

  <div class="shell relative py-20 text-center lg:py-28">
    <h2 class="reveal text-5xl sm:text-6xl lg:text-7xl">{finalCta.heading}</h2>

    <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-steel-300">
      {finalCta.body}
    </p>

    <div class="reveal mt-10">
      <CtaButton href="#buy" size="lg">{finalCta.cta}</CtaButton>
    </div>
  </div>
</section>
