---
import CtaButton from "../components/CtaButton.astro";
import ImageSlot from "../components/ImageSlot.astro";
import Icon from "../components/Icon.astro";
import { hero, motto } from "../data/product";
---

<section id="top" class="hero-short relative isolate flex min-h-svh flex-col overflow-hidden pt-20">
  <!-- Background stack: base gradient, topo texture, blue bloom -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-900 via-ink-950 to-ink-950"></div>
  <div class="texture-topo absolute inset-0 -z-10 opacity-60"></div>
  <div
    class="absolute -right-1/4 top-0 -z-10 h-[70vh] w-[70vw] rounded-full bg-brand-600/20 blur-[120px]"
  >
  </div>

  <!-- Peaks and pines from the badge logo, fading in toward the bottom -->
  <img
    src="/images/mountain-banner.webp"
    alt=""
    width="874"
    height="118"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-28 w-full object-cover object-center sm:h-32 lg:h-40 [mask-image:linear-gradient(to_bottom,transparent,black_45%)]"
  />

  <div class="shell grid flex-1 items-center gap-12 py-10 lg:grid-cols-2 lg:gap-16 lg:py-6">
    <!-- Copy column -->
    <div class="reveal is-visible">
      <p class="eyebrow">{hero.eyebrow}</p>

      <h1 class="mt-6 text-5xl leading-[0.9] sm:text-6xl lg:text-7xl xl:text-8xl">
        {hero.headlinePre}<br />
        <span class="slash mt-2 whitespace-nowrap"><span>{hero.headlineSlash}</span></span>
      </h1>

      <p class="hero-sub mt-7 max-w-xl text-lg leading-relaxed text-steel-300 sm:text-xl">
        {hero.sub}
      </p>

      <div class="hero-cta mt-9 flex flex-wrap items-center gap-4">
        <CtaButton href="#buy" size="lg">{hero.primaryCta}</CtaButton>
        <CtaButton href="#how-it-works" size="lg" variant="ghost">
          {hero.secondaryCta}
        </CtaButton>
      </div>

      <ul class="hero-trust mt-9 flex flex-wrap gap-x-7 gap-y-3">
        {
          hero.trust.map((item) => (
            <li class="flex items-center gap-2 text-sm text-steel-400">
              <Icon name="check" class="h-4 w-4 shrink-0 text-brand-400" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Product column -->
    <!-- On desktop the photo slot is sized from the viewport height, so the
         hero always leaves room for the motto and mountains below it. -->
    <div
      class="reveal is-visible relative lg:justify-self-end lg:[--slot-h:clamp(20rem,calc(100svh-27rem),46rem)]"
    >
      <!-- Angled accent panel behind the product shot -->
      <div
        class="absolute -inset-3 -z-10 bg-gradient-to-br from-brand-500/50 via-brand-700/20 to-transparent [clip-path:polygon(6%_0,100%_4%,94%_100%,0_96%)] sm:-inset-5"
      >
      </div>

      <div class="lg:h-[var(--slot-h)] lg:w-[calc(var(--slot-h)*0.8)]">
      <ImageSlot
        src={undefined}
        loading="eager"
        ratio="4 / 5"
        alt="Squeejit bottle held against a mud-covered UTV windshield"
        note="HERO SHOT. The bottle in a gloved hand, mid-squeegee, cutting a clean stripe through a muddy UTV windshield. Shoot late afternoon, dust in the air. Vertical crop."
        class="h-full w-full"
      />
      </div>

      <!-- Floating stat card -->
      <div
        class="absolute -bottom-6 left-0 border border-ink-700 bg-ink-900/95 px-5 py-4 shadow-[var(--shadow-lift)] backdrop-blur sm:left-8"
      >
        <p class="font-display text-4xl leading-none text-brand-400">{hero.stat.value}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.18em] text-steel-400">
          {hero.stat.label}
        </p>
      </div>
    </div>
  </div>

  <!-- Motto strip from the badge, then a racing-stripe rule closing the hero -->
  <ul
    class="hero-motto shell flex flex-wrap items-center justify-center gap-x-0 pb-28 pt-6 font-display sm:pb-32 lg:pb-40 text-2xl font-bold uppercase italic tracking-wide text-white sm:text-3xl"
    aria-label="Squirt it, scrub it, Squeejit"
  >
    {
      motto.map((word, i) => (
        <li
          class:list={[
            "px-5 sm:px-8",
            i > 0 && "border-l-2 border-brand-500",
            i === motto.length - 1 && "text-brand-400",
          ]}
        >
          {word}
        </li>
      ))
    }
  </ul>
  <div class="texture-stripe h-1.5 w-full"></div>
</section>
