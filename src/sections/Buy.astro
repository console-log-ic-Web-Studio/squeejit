---
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import { buy, site } from "../data/product";
---

<section id="buy" class="relative overflow-hidden bg-ink-900 py-20 lg:py-28">
  <div
    class="absolute left-1/2 top-0 -z-0 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-brand-600/15 blur-[130px]"
  >
  </div>

  <div class="shell relative">
    <SectionHeading eyebrow={buy.eyebrow} heading={buy.heading} align="center" />

    <ul class="mt-14 grid items-start gap-6 lg:grid-cols-3">
      {
        buy.options.map((option, i) => (
          <li
            class:list={[
              "reveal relative flex flex-col border bg-ink-850 p-8",
              option.featured
                ? "border-brand-500 shadow-[var(--shadow-glow)] lg:-mt-4 lg:pb-12"
                : "border-ink-700",
            ]}
            style={`transition-delay: ${i * 80}ms`}
          >
            {option.badge && (
              <span class="absolute -top-3 left-8 bg-splash-50 px-3 py-1 font-display text-xs font-bold uppercase tracking-[0.16em] text-ink-950">
                {option.badge}
              </span>
            )}

            <h3 class="text-3xl text-white">{option.name}</h3>
            <p class="mt-1.5 text-steel-400">{option.blurb}</p>

            <p class="mt-6 flex items-baseline gap-3">
              {option.price ? (
                <span class="font-display text-5xl font-extrabold leading-none text-white">
                  {option.price}
                </span>
              ) : (
                <span class="font-display text-3xl font-bold uppercase leading-none text-steel-300">
                  Pricing coming soon
                </span>
              )}
            </p>

            <ul class="mt-7 flex flex-1 flex-col gap-3">
              {option.includes.map((line) => (
                <li class="flex items-start gap-2.5 text-steel-300">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-400" />
                  <span>{line}</span>
                </li>
              ))}
            </ul>

            {/*
              No online checkout yet: the plan is local stores and trading
              posts first, Amazon later. Until then this is a mailto link.
              TODO(commerce): swap for the real buy link once one exists.
            */}
            <a
              href={`mailto:${site.email}?subject=${encodeURIComponent(`Squeejit: ${option.name}`)}`}
              data-sku={option.id}
              class:list={[
                "mt-8 block w-full px-6 py-4 text-center font-display text-lg font-bold uppercase tracking-wider transition [clip-path:polygon(0.75rem_0,100%_0,100%_calc(100%-0.75rem),calc(100%-0.75rem)_100%,0_100%,0_0.75rem)]",
                option.featured
                  ? "bg-brand-500 text-white hover:bg-brand-400"
                  : "border-2 border-ink-600 text-steel-200 hover:border-brand-500 hover:text-white",
              ]}
            >
              Ask about availability
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-10 text-center text-sm text-steel-400">{buy.note}</p>
  </div>
</section>
