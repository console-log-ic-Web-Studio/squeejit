---
/**
 * Snow-capped peaks plus a pine tree line, redrawn as vector from the
 * client's badge logo. Decorative only. Sits absolutely at the bottom of
 * its parent: the parent needs `relative` and the content needs to sit
 * above it. Colors come from the theme tokens in global.css.
 */
interface Props {
  class?: string;
  /** Hide the tree line and show only the peaks. */
  trees?: boolean;
}
const { class: className = "", trees = true } = Astro.props;

// Deterministic "random" so the tree line is identical on every build.
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

// Taller and denser at the edges, sparse in the middle, like the badge.
const pines: { x: number; h: number }[] = [];
for (let x = -10; x < 1450; x += 20 + rand() * 18) {
  const edge = Math.abs(x - 720) / 720; // 0 center, 1 edges
  const h = 55 + edge ** 1.6 * 110 + rand() * 40;
  if (edge < 0.35 && rand() < 0.65) continue;
  pines.push({ x, h });
}
---

<svg
  class:list={["pointer-events-none absolute inset-x-0 bottom-0 w-full", className]}
  viewBox="0 0 1440 400"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <symbol id="pine" viewBox="0 0 40 100">
      <path d="M20 0 30 28H25L34 52H28L38 80H22V100H18V80H2L12 52H6L15 28H10Z"></path>
    </symbol>
    <!-- Snow: one mass under the summit plus slanted wedges down each face,
         with a dark rock ridge band and a few rock windows, after the peaks on
         the badge. Drawn once with the apex at 0,0 and reused per peak. Each
         piece is its own path so overlaps don't cancel out. -->
    <clipPath id="snow-left"><rect x="-200" y="-20" width="200" height="300"></rect></clipPath>
    <g id="snow-shape">
      <path d="M0 14 12 20 70 64 10 50-10 56-72 66-14 20Z"></path>
      <path d="M46 46 12 46 59 84 108 96Z"></path>
      <path d="M93 84 75 84 95 100 128 112Z"></path>
      <path d="M32 62 16 62 60 98 92 110Z"></path>
      <path d="M-46 46 -8 46 -50 80 -103 92Z"></path>
      <path d="M-88 80 -72 80 -92 96 -123 108Z"></path>
      <path d="M-28 58 -12 58 -65 100 -96 112Z"></path>
    </g>
    <g id="snowcap">
      <path fill="var(--color-brand-700)" d="M0 -4 25 16 34 30 60 44 68 58 95 72 104 86 130 100 139 108 123 108 111 100 98 86 76 72 64 58 41 44 28 30 6 16 0 12ZM0 -4 -25 16 -34 30 -60 44 -68 58 -95 72 -104 86 -130 100 -139 108 -123 108 -111 100 -98 86 -76 72 -64 58 -41 44 -28 30 -6 16 0 12Z"></path>
      <use href="#snow-shape" fill="var(--color-splash-50)"></use>
      <use href="#snow-shape" fill="var(--color-brand-300)" opacity="0.7" clip-path="url(#snow-left)"></use>
      <path fill="var(--color-brand-700)" d="M-20 36-12 54-28 50ZM22 38 30 56 16 54Z"></path>
    </g>
  </defs>

  <!-- Far range -->
  <path
    fill="var(--color-brand-600)"
    opacity="0.4"
    d="M0 400V260L120 190 200 230 330 130 440 220 520 180 640 250 760 150 880 230 1000 170 1120 240 1240 160 1340 220 1440 190V400Z"
  ></path>
  <path
    fill="var(--color-brand-300)"
    opacity="0.2"
    d="M330 130 379 170 440 220 400 240 360 200ZM760 150 820 190 880 230 840 250 790 200ZM1240 160 1307 200 1340 220 1300 240 1260 200Z"
  ></path>
  <!-- Snow: a white mass from the summit with long tongues down the ridges
       and a light-blue shaded side, after the peaks on the badge. Drawn once
       with the apex at 0,0 and reused. -->
  <use href="#snowcap" transform="translate(330 130) scale(0.95)"></use>
  <use href="#snowcap" transform="translate(760 150) scale(-0.95 0.95)"></use>
  <use href="#snowcap" transform="translate(1240 160) scale(0.85)"></use>
  <use href="#snowcap" transform="translate(120 190) scale(-0.6 0.6)"></use>
  <use href="#snowcap" transform="translate(1000 170) scale(0.55)"></use>

  <!-- Near foothills -->
  <path
    fill="var(--color-brand-700)"
    opacity="0.75"
    d="M0 400V300L90 260 210 310 330 270 460 320 600 285 720 330 860 290 1000 325 1130 280 1260 320 1360 285 1440 310V400Z"
  ></path>

  {
    trees && (
      <g fill="var(--color-ink-950)">
        {pines.map((p) => (
          <use
            href="#pine"
            x={p.x}
            y={400 - p.h}
            width={p.h * 0.4}
            height={p.h}
          />
        ))}
        <rect x="0" y="385" width="1440" height="15" />
      </g>
    )
  }
</svg>
