---
/**
 * Wordmark. White heavy italic caps with a thick blue outline, matching the
 * SQUEEJIT banner on the client's badge logo.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class:list={["badge-caps inline-block px-1 text-3xl leading-none", className]}>
  Squeejit
</span>
