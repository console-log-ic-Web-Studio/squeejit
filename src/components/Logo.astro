---
/**
 * Wordmark. The client's own SQUEEJIT lettering (horizontal version), so the
 * header and footer match the bottle label exactly. The full badge artwork
 * lives at /images/logo-badge.webp for places that have room for it.
 *
 * Pass `alt=""` when the logo sits inside a link that already has an
 * aria-label (the header does), so it isn't announced twice.
 */
interface Props {
  class?: string;
  alt?: string;
}
const { class: className = "", alt = "Squeejit" } = Astro.props;
---

<img
  src="/images/logo-wordmark.webp"
  alt={alt}
  width="600"
  height="134"
  decoding="async"
  class:list={["h-10 w-auto sm:h-11", className]}
/>
